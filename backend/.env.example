# Required for LLM-assisted symptom parsing (FR-2.2).
# Without this set, the system degrades gracefully to manual-flag-only mode —
# it will NOT crash or block dispatch, but symptom text alone won't auto-flag anything.
ANTHROPIC_API_KEY=your-key-here

# Required for Whisper voice-to-text (FR-1.3), served via Groq — chosen over
# browser speech recognition for noise tolerance in a moving ambulance, and
# over OpenAI's own Whisper endpoint for free-tier access + lower latency.
# Get a free key at https://console.groq.com/keys
# Without this set, /api/transcribe returns a clear error and the EMT
# app prompts to type symptoms manually — it never blocks the flow.
GROQ_API_KEY=your-key-here
